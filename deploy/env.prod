# Production config for the hosted demo. Copy to .env at the repo root on the
# server, then set DOMAIN + your OpenRouter key (VLLM_API_KEY + CHAT_API_KEY).

# The public domain the client will open (must have a DNS A record → server IP):
DOMAIN=agilink-demo.change-me.com

# --- Databases / storage (internal to the server) ---
POSTGRES_USER=agilink
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=fiches_suiveuses
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agilink:CHANGE-ME-strong-db-password@postgres:5432/fiches_suiveuses
MINIO_ROOT_USER=agilink
MINIO_ROOT_PASSWORD=CHANGE-ME-strong-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=scans
MINIO_USE_SSL=false
REDIS_URL=redis://redis:6379/0

# --- AI (OpenRouter) — the key lives on the SERVER; the client never sees it ---
VLM_BACKEND=vllm
VLLM_BASE_URL=https://openrouter.ai/api/v1
VLLM_MODEL=qwen/qwen3.7-plus
VLLM_API_KEY=PASTE-YOUR-OPENROUTER-KEY-HERE
EXTRACT_PASSES=1
CHAT_MODEL=qwen/qwen3.7-plus
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=PASTE-YOUR-OPENROUTER-KEY-HERE
CHAT_REASONING_EFFORT=low

# --- App ---
API_SECRET_KEY=CHANGE-ME-random-secret
ENVIRONMENT=production
AUTO_INIT_DB=1
AUTO_VALIDATE=1
AUTO_VALIDATE_MIN_CONF=0.5
REF_PREFIX=10
SHAREPOINT_ENABLED=0
LOCAL_INBOX_ENABLED=0
