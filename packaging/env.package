# Agilink Fiches Suiveuses — local test configuration.
#
# ONLY ONE THING TO DO: paste your OpenRouter API key in the two lines marked
# below (VLLM_API_KEY and CHAT_API_KEY), then run the Start script.
# Get a key at https://openrouter.ai/keys
#
# Everything else is preset for a local test — no need to change it.

# --- Local databases / storage (run in containers on your machine) ---
POSTGRES_USER=agilink
POSTGRES_PASSWORD=agilink_local
POSTGRES_DB=fiches_suiveuses
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agilink:agilink_local@postgres:5432/fiches_suiveuses

MINIO_ROOT_USER=agilink
MINIO_ROOT_PASSWORD=agilink_local_123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=scans
MINIO_USE_SSL=false

REDIS_URL=redis://redis:6379/0

# --- AI models (via OpenRouter) — REQUIRED ---------------------------------
# Handwriting extraction. Paste your OpenRouter key on the VLLM_API_KEY line.
VLM_BACKEND=vllm
VLLM_BASE_URL=https://openrouter.ai/api/v1
VLLM_MODEL=qwen/qwen3.7-plus
VLLM_API_KEY=PASTE-YOUR-OPENROUTER-KEY-HERE
EXTRACT_PASSES=1

# Analytical chat copilot. Paste the SAME OpenRouter key on CHAT_API_KEY.
CHAT_MODEL=qwen/qwen3.7-plus
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=PASTE-YOUR-OPENROUTER-KEY-HERE
CHAT_REASONING_EFFORT=low
# ---------------------------------------------------------------------------

# --- Application ---
API_SECRET_KEY=local_test_secret_change_me
ENVIRONMENT=production
AUTO_INIT_DB=1
AUTO_VALIDATE=1
AUTO_VALIDATE_MIN_CONF=0.5
REF_PREFIX=10

# Auto-ingest pollers are OFF for a simple manual test (upload from the UI).
SHAREPOINT_ENABLED=0
LOCAL_INBOX_ENABLED=0
