# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=agilink
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fiches_suiveuses
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agilink:changeme@postgres:5432/fiches_suiveuses

# --- MinIO (S3-compatible object storage for scans) ---
MINIO_ROOT_USER=agilink
MINIO_ROOT_PASSWORD=changeme123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=scans
MINIO_USE_SSL=false

# --- Redis (Celery broker/backend) ---
REDIS_URL=redis://redis:6379/0

# --- VLM extraction backend ---
# "groq" for the cloud POC, "vllm" for the on-prem production target.
VLM_BACKEND=groq

# Self-consistency voting: extract each sheet this many times and majority-vote
# per cell (cancels random VLM misreads; inter-run agreement becomes a calibrated
# confidence for the auto-validate gate). 1 = off (single pass). 3 is the sweet
# spot; higher = more accurate/robust but linearly more cost + latency.
EXTRACT_PASSES=3

# Cross-model verification ("judge"): after the primary VLM extracts a sheet, a
# DIFFERENT model re-extracts it independently and the two are cross-checked
# per cell. Because the models have different blind spots, a disagreement
# surfaces a real error (and drops that cell's confidence → routed to review),
# while agreement is a trustworthy confidence for the auto-validate gate.
# Must be a model that honours strict JSON on OpenRouter (gpt-4o / gpt-4.1 /
# qwen2.5-vl-72b do; gemini-2.5-pro does NOT). Leave blank to disable (single
# model). Doubles the model cost per sheet.
JUDGE_MODEL=openai/gpt-4o

# Rule-based auto-validation: a freshly-extracted sheet that passes EVERY
# deterministic check (zero validation issues) is validated with NO human review
# (statut -> valide). The gate is the rules, not the model's confidence.
# AUTO_VALIDATE=0 disables it (everything goes to the review queue).
# AUTO_VALIDATE_MIN_CONF is a secondary floor only (the rules are the real gate).
AUTO_VALIDATE=1
AUTO_VALIDATE_MIN_CONF=0.9

# Groq (POC only — scans leave the premises; rotate this key after the POC,
# and do not use in production without Agilink's explicit sign-off).
GROQ_API_KEY=changeme
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# vLLM (self-hosted, on-prem production target). To use it: set VLM_BACKEND=vllm
# above and start the stack with `docker compose --profile gpu up -d`.
# Fully on-prem — scans never leave the client's network.
VLLM_BASE_URL=http://vllm:8000/v1          # compose-internal DNS name of the vllm service
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct     # 3B (~10GB VRAM) / 7B (~18GB) / 32B / 72B
VLLM_API_KEY=EMPTY                          # only needed if you start vLLM with --api-key
# Optional HF token to avoid download rate limits (Qwen2.5-VL is open/ungated,
# so usually not required):
HUGGING_FACE_HUB_TOKEN=

# --- Chatbot copilot (separate from the VLM) ---
# A TEXT, tool-calling LLM that answers over the extracted data — NOT a vision
# model. Configured independently of the VLM so the VLM can go on-prem (vision
# only) while chat uses an appropriate text model. If CHAT_BASE_URL/CHAT_API_KEY
# are left blank they fall back to the VLLM_* connection (back-compat).
# Primary pick: qwen3-30b-a3b (cheap, strong multilingual + tools).
# Fallback if it underperforms: google/gemini-2.5-flash-lite.
CHAT_MODEL=qwen/qwen3-30b-a3b-instruct-2507
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=changeme

# --- API ---
API_SECRET_KEY=changeme
ENVIRONMENT=development

# Agilink product refs start with this prefix; a ref that does not is flagged as a
# probable leading-digit misread (e.g. 10108044 read as 20208044). Blank disables.
REF_PREFIX=10

# --- SharePoint auto-ingest (Microsoft Graph delta poller) ---
# When enabled, the `beat` service polls a SharePoint folder every
# SHAREPOINT_POLL_SECONDS and feeds any NEW pdf into the same pipeline as a
# manual upload (manual upload keeps working unchanged). App-only auth: create
# an Azure AD app registration with the Files.Read.All + Sites.Read.All
# APPLICATION permissions and grant admin consent (see docs/SHAREPOINT_SETUP.md).
SHAREPOINT_ENABLED=0
SHAREPOINT_TENANT_ID=            # Azure AD (Entra) tenant/directory id
SHAREPOINT_CLIENT_ID=           # app registration (client) id
SHAREPOINT_CLIENT_SECRET=       # app registration client secret VALUE
# Identify the document library: EITHER the site id OR the drive id.
SHAREPOINT_SITE_ID=             # e.g. contoso.sharepoint.com,<siteGuid>,<webGuid>
SHAREPOINT_DRIVE_ID=            # optional; overrides the site's default drive
SHAREPOINT_FOLDER_PATH=Scans    # folder to watch, relative to the drive root (blank = whole drive)
SHAREPOINT_POLL_SECONDS=180     # how often to check for new files

# --- Local drop-folder auto-ingest ---
# Filesystem alternative to SharePoint (no cloud/Azure needed): drop files into
# ./inbox (mounted into worker+beat) and they upload + scan automatically.
# Processed files move to ./inbox/processed. Needs the `beat` service running.
LOCAL_INBOX_ENABLED=0
LOCAL_INBOX_DIR=/srv/inbox       # container path; host ./inbox is mounted here
LOCAL_INBOX_POLL_SECONDS=30
