# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env / secrets
.env
.env.*
!.env.example

# Node / frontend
node_modules/
frontend/dist/
frontend/build/

# Data / scans (never commit real Agilink data) — case-sensitive on Linux,
# so cover the capitalised folder the scans actually live in too.
data/
scans/
Scans/
*.sqlite3

# Docker
*.pid

# IDE / OS
.vscode/
.idea/
.DS_Store

# Alembic local sqlite (if ever used for quick tests)
db/*.db

# Real scanned fiches (real Agilink data — never commit, esp. to a public repo).
# The blank template docs/fixtures/*VIERGE*.pdf is kept as a layout reference.
/TapScanner*.pdf
docs/fixtures/sample_filled_sheet.pdf

# --- never commit: real scans, big media, stray files ---
/Test_file_6948.pdf
/Logo-png.png
*.mp4
# local drop-folder: keep README + structure, never the dropped scans
inbox/*.pdf
inbox/*.jpg
inbox/*.jpeg
inbox/*.png
inbox/processed/*.pdf
inbox/processed/*.jpg
inbox/processed/*.jpeg
inbox/processed/*.png
